# --- Server ---
NODE_ENV=development
PORT=4000
# Where the browser-facing frontend lives (CORS origin + post-login redirect).
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug
# Serve Swagger UI at /api/docs (all endpoints) and /api/v1/docs (public API only).
SWAGGER_ENABLED=true

# --- Database (SQLite file; relative paths resolve from the backend root) ---
DATABASE_URL=file:./data/records.db

# --- Auth ---
# Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=168
# Comma-separated list of company email domains allowed to sign in.
ALLOWED_EMAIL_DOMAINS=partnerhero.com
# First user, created automatically on startup when no users exist. They can invite everyone else.
INITIAL_USER_EMAIL=admin@partnerhero.com

# Google OAuth — placeholders until credentials are created in GCP.
# While these remain "placeholder", the Google login routes return 503.
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Local-only: enables POST /api/auth/dev-login (never active when NODE_ENV=production).
AUTH_DEV_LOGIN=true
