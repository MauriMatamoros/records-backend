# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public hostname pointing at the VM (A/AAAA record). Use "localhost" to try the stack locally.
DOMAIN=records.partnerhero.com
# Contact for Let's Encrypt certificate notices.
ACME_EMAIL=ops@partnerhero.com

# openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
SESSION_TTL_HOURS=168
LOG_LEVEL=info

ALLOWED_EMAIL_DOMAINS=partnerhero.com
# Created on first start when there are no users yet.
INITIAL_USER_EMAIL=admin@partnerhero.com

# Google OAuth client (Web application). Authorized redirect URI:
#   https://<DOMAIN>/api/auth/google/callback
# Google sign-in stays disabled (503) while these are "placeholder".
GOOGLE_CLIENT_ID=placeholder
GOOGLE_CLIENT_SECRET=placeholder

# Set to false to hide Swagger UI (/api/docs and /api/v1/docs).
SWAGGER_ENABLED=true
